{
  // VieTing trên Cloudflare: trang tải app (/tai-app) + server đồng bộ (/api).
  // Chạy tai-len-cloudflare.bat (thư mục gốc) để đưa lên.
  "name": "vieting",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vieting",
      // Dán ID nhận được sau lệnh "wrangler d1 create vieting" vào đây
      "database_id": "3b66fd65-a0f2-4a2e-9440-3e3b51e25221"
    }
  ],
  // Trợ lý AI: Workers AI miễn phí (dự phòng khi chưa có khóa Gemini)
  "ai": { "binding": "AI" },
  // GEMINI_MODEL: để trống = server tự chọn model Gemini (ưu tiên Flash-Lite vì hạn mức miễn phí rộng)
  "vars": {},
  // Chạy Worker ở Singapore: người dùng Việt Nam hay bị Cloudflare định tuyến qua Hồng Kông,
  // nơi Google chặn Gemini ("User location is not supported"). Singapore gần VN và được Gemini hỗ trợ.
  "placement": { "region": "gcp:asia-southeast1" },
  "observability": { "enabled": true },
  // Đọc ngân hàng của Quỹ chung đã nối (SePay) mỗi 10 phút, để tiền ra được báo cả khi không ai mở app
  "triggers": { "crons": ["*/10 * * * *"] }
}
